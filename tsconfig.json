{
    "compilerOptions": {
       "target": "es2016",
        "module": "commonjs",
        "paths": {
            "@/*": ["./src/*"],
            "@controllers/*": ["./src/controllers/*"],
            "@routes/*": ["./src/routes/*"],
            "@config/*": ["./src/config/*"],
            "@assets/*": ["./assets/*"]
        },
        "typeRoots": [
            "./node_modules/@types",
            "./types"
        ],
        "outDir": "./dist",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "strictNullChecks": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*", "types"],
    "exclude": ["node_modules"],
    "files": ["global.d.ts"]
}