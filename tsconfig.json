{
    "compilerOptions": {
        "target": "es2016",
        "module": "commonjs",
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@controllers/*": [
                "./src/controllers/*"
            ],
            "@routes/*": [
                "./src/routes/*"
            ],
            "@config/*": [
                "./src/config/*"
            ]
        },
        "resolveJsonModule": true,
        "outDir": "./dist",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "strictNullChecks": true,
        "skipLibCheck": true
    }
}